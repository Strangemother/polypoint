                    "type": "MethodDefinition",
                    "comments": {
                        "header": [],
                        "inner": [
                            {
                                "text": "Locked to the pointing direction of self, assuming a _ray_ case from the center through\nthe tip of this (self) point. Only moving _forward_ or _backward_ but not sliding.\n\nThe constraint is applied only when this method is called.",
                                "block": true,
                                "line": 55
                            }
                        ]
                    },
